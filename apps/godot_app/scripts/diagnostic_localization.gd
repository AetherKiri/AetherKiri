static func get_text(language: String, key: String) -> String:
    var language_table: Dictionary = TEXT.get(language, TEXT["en"])
    if language_table.has(key):
        return String(language_table[key])
    return String(TEXT["en"].get(key, key))

static func has_key(key: String) -> bool:
    return TEXT["en"].has(key)

static func validate() -> PackedStringArray:
    var missing := PackedStringArray()
    var keys: Array = TEXT["en"].keys()
    for language in TEXT:
        for key in keys:
            if not TEXT[language].has(key):
                missing.append("%s:%s" % [language, key])
    return missing
