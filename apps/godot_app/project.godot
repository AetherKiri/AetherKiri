; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[aether_kiri]

game_path=""

[application]

config/name="Aether"
config/version="0.2.0-beta.1"
config/use_custom_user_dir.macos=true
config/custom_user_dir_name.macos="Godot/app_userdata/AetherKiri"
config/use_custom_user_dir.windows=true
config/custom_user_dir_name.windows="Godot/app_userdata/AetherKiri"
config/use_custom_user_dir.linux=true
config/custom_user_dir_name.linux="godot/app_userdata/AetherKiri"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/stretch_mode=0
config/icon="res://assets/icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080

[editor_plugins]

enabled=PackedStringArray()

[rendering]

rendering_device/driver.android="vulkan"
rendering_device/fallback_to_opengl3=true
rendering/gl_compatibility/driver.android="opengl3"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.android="mobile"
